<?xml version="1.0" encoding="utf-8"?>

<!--
    Order confirmation screen.

    This layout confirms that the customer's order was placed
    successfully, displays the final order total, and provides
    navigation back to the main coffee menu.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Displays a simple success indicator. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓"
        android:textColor="#2E7D32"
        android:textSize="72sp"
        android:textStyle="bold" />

    <!-- Confirms that the order was successfully completed. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/order_success_title"
        android:textColor="#202020"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Provides a short confirmation message to the user. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/order_success_message"
        android:textColor="#555555"
        android:textSize="16sp" />

    <!-- Displays the final total from the completed order. -->
    <TextView
        android:id="@+id/orderTotalTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Order Total: $0.00"
        android:textColor="#C8102E"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Returns the user to the main coffee menu. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/backToMenuButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="@string/back_to_menu"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>