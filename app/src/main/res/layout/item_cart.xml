<?xml version="1.0" encoding="utf-8"?>

<!--
    Layout for a single product displayed in the shopping cart.

    Each cart item shows the coffee name, selected quantity,
    unit price, and calculated subtotal.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Displays the coffee product name. -->
        <TextView
            android:id="@+id/cartCoffeeNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Double Double"
            android:textColor="#202020"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Displays the selected quantity. -->
        <TextView
            android:id="@+id/cartQuantityTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Quantity: 2"
            android:textColor="#555555"
            android:textSize="15sp" />

        <!-- Displays the unit price of the coffee. -->
        <TextView
            android:id="@+id/cartUnitPriceTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Price: $2.49"
            android:textColor="#555555"
            android:textSize="15sp" />

        <!-- Displays the subtotal for this cart item. -->
        <TextView
            android:id="@+id/cartSubtotalTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Subtotal: $4.98"
            android:textColor="#C8102E"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>