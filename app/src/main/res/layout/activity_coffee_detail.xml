<?xml version="1.0" encoding="utf-8"?>

<!--
    Coffee detail screen.

    This layout displays the selected coffee information,
    quantity controls, and an Add to Cart action.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Displays the selected coffee product image. -->
        <ImageView
            android:id="@+id/detailCoffeeImageView"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:contentDescription="@string/coffee_image"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_launcher" />

        <!-- Displays the selected coffee product name. -->
        <TextView
            android:id="@+id/detailCoffeeNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Double Double"
            android:textColor="#202020"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Displays the unit price of the selected coffee. -->
        <TextView
            android:id="@+id/detailCoffeePriceTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="$2.49"
            android:textColor="#C8102E"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- Displays the product description. -->
        <TextView
            android:id="@+id/detailCoffeeDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="Coffee description"
            android:textColor="#444444"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/quantity_label"
            android:textColor="#202020"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!--
            Quantity selector containing decrease, current quantity,
            and increase controls.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/decreaseQuantityButton"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:text="@string/decrease_quantity"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/quantityTextView"
                android:layout_width="80dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="1"
                android:textColor="#202020"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/increaseQuantityButton"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:text="@string/increase_quantity"
                android:textSize="22sp" />

        </LinearLayout>

        <!-- Adds the selected coffee and quantity to the shopping cart. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addToCartButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/add_to_cart"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>