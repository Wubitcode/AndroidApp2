<?xml version="1.0" encoding="utf-8"?>

<!--
    Main layout for the Tim Hortons coffee menu.

    The screen contains:
    1. A branded header displaying the application title.
    2. A RecyclerView that displays the available coffee products.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F7">

    <!--
        Header section displayed at the top of the main menu.
        It provides the application name and a short menu description.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:background="#C8102E">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TIM HORTONS"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/menu_title"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/menu_subtitle"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

    <!--
        Displays the coffee products in a vertically scrolling list.
        The RecyclerView is populated programmatically in MainActivity.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/coffeeRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="12dp" />

</LinearLayout>